+//! Give every fission site a progeny id that is unique within its source
+//! family and independent of which thread transported the daughter.
+void assign_eigenvalue_fission_progeny()
+{
+  auto& bank = simulation::fission_bank;
+  const int64_t n_source = simulation::work_per_rank;
+  simulation::progeny_per_particle.assign(n_source, 0);
+  if (bank.size() == 0)
+    return;
+
+  struct Key {
+    int64_t parent;
+    int64_t track;
+    int64_t local;
+    int64_t index;
+  };
+  vector<Key> keys;
+  keys.reserve(bank.size());
+  for (int64_t i = 0; i < bank.size(); ++i) {
+    const auto& site = bank[i];
+    if (site.parent_id < 0 || site.parent_id >= n_source) {
+      fatal_error(fmt::format(
+        "Invalid fission parent_id {} (expected range [0, {})).",
+        site.parent_id, n_source));
+    }
+    keys.push_back({site.parent_id, site.ancestor_id, site.progeny_id, i});
+  }
+  std::sort(keys.begin(), keys.end(), [](const Key& a, const Key& b) {
+    if (a.parent != b.parent)
+      return a.parent < b.parent;
+    if (a.track != b.track)
+      return a.track < b.track;
+    if (a.local != b.local)
+      return a.local < b.local;
+    return a.index < b.index;
+  });
+
+  int64_t previous_parent = -1;
+  int64_t progeny = 0;
+  for (const auto& key : keys) {
+    if (key.parent != previous_parent) {
+      previous_parent = key.parent;
+      progeny = 0;
+    }
+    auto& site = bank[key.index];
+    site.progeny_id = progeny++;
+    site.ancestor_id = 0;
+    simulation::progeny_per_particle[key.parent]++;
+  }
+}
