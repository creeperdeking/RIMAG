+void Particle::tag_fission_site(SourceSite& site)
+{
+  if (settings::run_mode == RunMode::EIGENVALUE &&
+      settings::use_shared_secondary_bank) {
+    // Daughters of this source may be running on other threads. Keep the
+    // original source index, and record which track gave birth to the site
+    // so the progeny numbers can be assigned in a fixed order afterwards.
+    site.parent_id = ancestor_id();
+    site.progeny_id = n_fission_progeny()++;
+    site.ancestor_id = track_id();
+  } else {
+    site.parent_id = current_work();
+    site.progeny_id = n_progeny()++;
+  }
+}
+
+void Particle::untag_failed_fission_site()
+{
+  if (settings::run_mode == RunMode::EIGENVALUE &&
+      settings::use_shared_secondary_bank) {
+    n_fission_progeny()--;
+  } else {
+    n_progeny()--;
+  }
+}
