+//! Drop a secondary generation that is too large to transport.
+//!
+//! The fission sites already banked by earlier tracks stay. The discarded
+//! tracks never start, and the cleared bank ends the secondary-generation loop.
+void discard_secondary_generation(int generation, int64_t n_tracks)
+{
+  simulation::shared_secondary_bank_write.clear();
+  simulation::shared_secondary_bank_read.clear();
+  if (mpi::master) {
+    warning(fmt::format(
+      "Secondary generation {} has {} tracks, above the limit of {}. "
+      "This generation is discarded and later secondary generations are not "
+      "run. Tracks already completed in this fission generation are kept.",
+      generation, n_tracks, settings::max_generation_tracks));
+  }
+}
+
+bool secondary_generation_within_limit(int generation, int64_t n_tracks)
+{
+  if (settings::max_generation_tracks <= 0 ||
+      n_tracks <= settings::max_generation_tracks) {
+    return true;
+  }
+  discard_secondary_generation(generation, n_tracks);
+  return false;
+}
+
 } // namespace
 
